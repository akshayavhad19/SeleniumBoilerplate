
public class calci {
	public static void main(String[] args) {
     int num1=25;
     float num2=25.25f;
     calci obj= new calci();
     double summ=obj.addition(num1, num2);
     System.out.println("Sum"+summ);
	}

	public double addition(int num1, float num2) {
		double sum=num1 + num2;
		return sum;
		
	}
}
