package com.qa.videos;

import java.util.Arrays;

public class Main {
	public static void main(String[] args)
	{
		String str = "test strings";
		printDuplicates(str);
	}

	public static void printDuplicates(String str) {

		int len=str.length();

		char charArr[]=str.toCharArray();

		Arrays.sort(charArr);
		String sortedArr= new String(charArr);
		for (int i=0;i<len;i++) {
			int count=1;
			while (i<len-1 && sortedArr.charAt(i)== sortedArr.charAt(i+1)) {
				count++;
				i++;
			}
			if(count>1) {
				System.out.println(sortedArr.charAt(i)+" , count= "+count);
			}
		}
	}

}
