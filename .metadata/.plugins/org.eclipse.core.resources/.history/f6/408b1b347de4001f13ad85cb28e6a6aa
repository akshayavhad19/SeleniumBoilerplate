		driver.get(loginUrl); // Open video URL
		driver.manage().window().maximize();

		doSendKeys(email_Id, "kahob83627@ndiety.com");
		doSendKeys(pass, "Testuser@1234");
		doClick(checkbox);
		doClick(submitBtn);
		Thread.sleep(3000);

		String[] videoLinks = {
				"https://" + username + ":" + password + "@nginx-pro-bi-com-jp-across-ckd-develop.bi3.bi-oneweb.com/jp/across/slidelibrary/KEE_video_CARMELINA_J",
